# Copy to .env and replace every placeholder. Never commit .env.
# Generate secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"

# --- PostgreSQL (used by docker-compose and by DATABASE_URL below) ---
POSTGRES_USER=governit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=governit
# Host port for the Docker Postgres. 5433 avoids clashing with a native Postgres on 5432.
POSTGRES_PORT=5433

# Must use the same user/password/port/db as above.
DATABASE_URL=postgresql://governit:change-me@localhost:5433/governit?schema=public

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Admin auth (each at least 32 characters in production) ---
ADMIN_SECRET=change-me-at-least-32-characters-long
AUTH_SECRET=change-me-at-least-32-characters-long
# Admin accounts: comma-separated login:password pairs. The login can be an email address.
# These are the ONLY accounts that can sign in at /admin/login. Passwords: 8+ characters (use 16+).
ADMIN_USERS=you@example.com:change-me-long-password

# --- Scheduled source checks ---
# Bearer token required by /api/cron/check-sources (at least 32 characters in production).
CRON_SECRET=change-me-at-least-32-characters-long
